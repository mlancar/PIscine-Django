<!DOCTYPE html>

<html lang="fr">
    <head>
        <title> Ceci n'est pas un CV</title>
        <meta charset="UTF-8">
        <style>
            th {{border: 1px solid; border-collapse:collapse;}}
            hr {{width: 80%; height:1px; background: black;}}
            table tbody tr:last-child th:last-child {{border-color: #424242;}}
        </style>
    </head>
    <body>
        <div id="page-container" style="border:solid; background-color: #8fa77f; width: 35rem; height: 80%;">  
           
            <h1 style="text-align: center;"> {desired_position}</h1>
            <div id="information" style="display:flex; justify-content: space-between; ">
                <ul>
                    <li>{name}</li>
                    <li>{address}</li>
                    <li>{phone_number}</li>
                    <li>{email_address}</li>
                </ul>
                <div id="profile-picture">
                    <img src="{image}" alt="profile-pic" style="width: 60%" >
                </div>
            </div>
            <hr>
            <div id="cv-content" style="display:flex; flex-direction: column;  align-items: center;">
                <h2>  EXPERIENCE</h2>
                <div id="formation-field" style="width: 80%; display: flex;" >
                    <div id="table-content" style="display: flex; justify-content: center;">
                        <table id="table" style="border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th >Date</th>
                                    <th >Travail</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                    <tr>
                                        <th>{time1}</th>
                                        <th>{job_name1}</th>
                                        <th>{job_description1}</th>
                                    </tr>
                                    <tr>
                                            <th>{time2}</th>
                                        <th>{job_name2}</th>
                                        <th>{job_description2}</th>
                                    </tr>
                                    <tr>
                                            <th>{time3}</th>
                                        <th>{job_name3}</th>
                                        <th>{job_description3}</th>
                                    </tr>
                                    <tr>
                                        <th>{time4}</th>
                                        <th>{job_name4}</th>
                                        <th>{job_description4}</th>
                                    </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <hr>
                <h3> FORMATION </h3>
                <div id="experience-field" style="width: 80%; display: flex;">
                    <ol>
                        <li>{school_name}</li>
                        <li>{school_name2}</li>
                    </ol>
                </div>
                <hr>
                <h4> CENTRE D'INTERET</h4>
                <div id="interest-field" style="width: 80%; display: flex;">
                    <ul>
                        <li>{hobby1}</li>
                        <li>{hobby2}</li>
                        <li>{hobby3}</li>
                        <li>{hobby3}</li>
                        
                    </ul>
                </div>
            </div>
        </div>
    </body>
   
</html>